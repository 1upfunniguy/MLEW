{
  "version": 2,
  "cleanUrls": true,
  "builds": [
    {
      "src": "api/*.py",
      "use": "@vercel/python"
    }
  ],
  "redirects": [
    {
      "source": "/rat",
      "destination": "/bigrat",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/mlewg/edu/eykiw/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
